# BEGIN bootstrap.py --upgrade managed block -- do not edit lines between BEGIN/END
* text=auto eol=lf

# Binary files: excluded from LF/CRLF normalisation and diffed as opaque blobs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.pptx binary
*.docx binary
*.xlsx binary

# Pipeline metrics log (FR-0002 / H6): append-only NDJSON, one record per
# line. `merge=union` lets concurrent appends on different branches (an agent
# worktree's gate runs, the dispatcher's PR events) merge without conflict —
# every line is a self-contained record, so order between branches is
# irrelevant and no line is ever edited. See specs/_metrics/README.md.
specs/_metrics/*.ndjson merge=union
# END bootstrap.py --upgrade managed block
